{
	"name": "content-freeze",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "cross-env PAYLOAD_DROP_DATABASE=true NODE_OPTIONS=--no-deprecation next dev --turbopack --port 3005",
		"build": "cross-env NODE_OPTIONS=--no-deprecation next build",
		"prestart": "rm -rf src/payload/migrations && pnpm payload migrate:create && printf \"y\n\" | pnpm payload migrate:fresh",
		"start": "cross-env NODE_OPTIONS=--no-deprecation next start --port 3005",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"tsc": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
		"lint": "pnpm lint:biome && pnpm lint:styles",
		"lint:biome": "biome check --write .",
		"lint:styles": "stylelint --fix=strict --allow-empty-input \"**/*.scss\"",
		"payload": "cross-env NODE_OPTIONS=--no-deprecation payload"
	},
	"dependencies": {
		"@payload-bites/content-freeze": "workspace:*",
		"@payloadcms/db-postgres": "3.94.0",
		"@payloadcms/next": "3.94.0",
		"@payloadcms/translations": "3.94.0",
		"@payloadcms/ui": "3.94.0",
		"cross-env": "^10.1.0",
		"next": "16.4.6",
		"payload": "3.94.0",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@payload-bites/typescript-config": "workspace:*",
		"@types/node": "24.13.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"typescript": "6.0.3"
	}
}
