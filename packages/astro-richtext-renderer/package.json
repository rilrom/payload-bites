{
	"name": "@payload-bites/astro-richtext-renderer",
	"description": "render Payload CMS Lexical richtext content in Astro",
	"version": "3.0.0-beta.0",
	"author": "Riley Langbein <rilrom-dev@protonmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rilrom/payload-bites.git"
	},
	"bugs": "https://github.com/rilrom/payload-bites/issues",
	"homepage": "https://github.com/rilrom/payload-bites/blob/main/packages/astro-richtext-renderer#readme",
	"keywords": [
		"payload",
		"payloadcms",
		"payload-plugin",
		"astro",
		"lexical"
	],
	"type": "module",
	"private": false,
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"src"
	],
	"scripts": {
		"lint": "pnpm lint:biome && pnpm lint:styles",
		"lint:biome": "biome check --write .",
		"lint:styles": "stylelint --fix=strict \"**/*.css\"",
		"tsc": "astro check",
		"test": "pnpm test:unit",
		"test:unit": "vitest run"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@payload-bites/typescript-config": "workspace:*",
		"astro": "7.4.11",
		"typescript": "6.0.3",
		"vitest": "4.1.12"
	},
	"peerDependencies": {
		"@payloadcms/richtext-lexical": ">=4.0.0-beta.10 <5.0.0",
		"astro": "^7.4.7"
	}
}
